# Local-only agent instructions (not published)
/AGENTS.md

# Session data — contains cookies and access_token (secrets)
/session/
mexporter.exe
mexporter.json
mexporter-*.json

# Logs and temporary output from Playwright/session capture
*.log
.notes
export-*
inbox-backfill.*
resume.*
run_*
.playwright-mcp/

# JSON files with session tokens (keep only if needed for dev)
# *.json

# Python bytecode cache (from migration scripts)
__pycache__/
*.pyc
scripts/migrate_to_imap.cpython-*.pyc

# Local coverage artifacts
cover.out
cover.txt

# Release archives built by scripts/package-release.ps1
dist/